# Clarifo API key (clf_live_... or clf_test_...), created in Clarifo under Settings > API keys.
# Needs a Pro, Team or Enterprise plan (or the 7-day Pro trial). Never commit a real key.
CLARIFO_API_KEY=
CLARIFO_MCP_URL=https://mcp.clarifo.com/mcp
ANTHROPIC_API_KEY=
# Any LangChain model string, e.g. openai:<model>
LANGCHAIN_MODEL=anthropic:claude-sonnet-5-5
